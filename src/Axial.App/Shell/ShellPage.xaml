<Page x:Class="Axial.App.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Axial.App.Shell"
    Background="Transparent">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Titelzeile -->
            <RowDefinition Height="*" />      <!-- Modulfläche -->
            <RowDefinition Height="Auto" />   <!-- dynamische Toolbar -->
        </Grid.RowDefinitions>

        <!-- Titelzeile: randlos, verschiebbar -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="48"
                Padding="16,0,16,0"
                HorizontalAlignment="Stretch">
            <Border.Background>
                <AcrylicBrush TintColor="#1B1E24" TintOpacity="0.6" FallbackColor="#1B1E24" />
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Axial" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource AxialOnSurfaceBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ModuleTitle" Text="Rechner"
                           FontSize="13" Opacity="0.75" Margin="12,0,0,0"
                           Foreground="{StaticResource AxialOnSurfaceBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Modulfläche: das aktive Modul lebt hier -->
        <ContentControl x:Name="ModuleHost" Grid.Row="1" Margin="12,8,12,8" />

        <!-- Dynamische Toolbar (unten, Glas) -->
        <Border x:Name="Toolbar" Grid.Row="2"
                CornerRadius="16,16,0,0"
                Padding="8"
                HorizontalAlignment="Stretch">
            <Border.Background>
                <AcrylicBrush TintColor="#20242C" TintOpacity="0.72" FallbackColor="#20242C" />
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tool-Menü-Button -->
                <Button x:Name="ToolMenuButton" Grid.Column="0"
                        Padding="14,8" CornerRadius="{StaticResource AxialCornerRadiusTight}"
                        Background="{StaticResource AxialAccentBrush}"
                        Foreground="White"
                        Click="OnToolMenu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                        <TextBlock Text="Werkzeuge" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Modul-Aktionen (kontextabhängig) -->
                <StackPanel x:Name="ModuleActions" Grid.Column="1"
                            Orientation="Horizontal" Spacing="8" Margin="12,0" />

                <!-- Statusanzeige -->
                <TextBlock x:Name="StatusChip" Grid.Column="2"
                           Text="Kern 0.1.0"
                           FontSize="12" Opacity="0.7"
                           Foreground="{StaticResource AxialOnSurfaceBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
