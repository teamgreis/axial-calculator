<Page x:Class="Axial.App.Modules.Calculator.CalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Anzeige -->
            <RowDefinition Height="Auto" />  <!-- Fehlerzeile -->
            <RowDefinition Height="*" />     <!-- Tastenfeld -->
        </Grid.RowDefinitions>

        <!-- Anzeige -->
        <Border Grid.Row="0" CornerRadius="14" Padding="18,14">
            <Border.Background>
                <AcrylicBrush TintColor="#171A20" TintOpacity="0.55" FallbackColor="#171A20" />
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Eingabe" FontSize="11" Opacity="0.6"
                           Foreground="{StaticResource AxialOnSurfaceVariantBrush}" />
                <TextBox x:Name="InputBox" FontSize="26" BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource AxialOnSurfaceBrush}"
                         KeyDown="OnInputKeyDown" />
                <TextBlock Text="Ergebnis" FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                           Foreground="{StaticResource AxialOnSurfaceVariantBrush}" />
                <TextBlock x:Name="ResultText" Text="—" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource AxialAccentSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Fehlerzeile (typisiert: Ursache + Hinweis) -->
        <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="18,6,18,0"
                   FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- Tastenfeld: 5 Spalten -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Reihe 1 -->
            <Button Grid.Row="0" Grid.Column="0" Content="C"  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="clear" />
            <Button Grid.Row="0" Grid.Column="1" Content="("  Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="(" />
            <Button Grid.Row="0" Grid.Column="2" Content=")"  Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag=")" />
            <Button Grid.Row="0" Grid.Column="3" Content="%"  Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="%" />
            <Button Grid.Row="0" Grid.Column="4" Content="⌫"  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="back" />

            <!-- Reihe 2 -->
            <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="7" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="8" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="9" />
            <Button Grid.Row="1" Grid.Column="3" Content="÷"  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="/" />
            <Button Grid.Row="1" Grid.Column="4" Content="√"  Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="sqrt(" />

            <!-- Reihe 3 -->
            <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="4" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="5" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="6" />
            <Button Grid.Row="2" Grid.Column="3" Content="×"  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="*" />
            <Button Grid.Row="2" Grid.Column="4" Content="x²" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="^2" />

            <!-- Reihe 4 -->
            <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="1" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="2" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="3" />
            <Button Grid.Row="3" Grid.Column="3" Content="−"  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="-" />
            <Button Grid.Row="3" Grid.Column="4" Content="ans" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="ans" />

            <!-- Reihe 5 -->
            <Button Grid.Row="4" Grid.Column="0" Content="0"  Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="0" />
            <Button Grid.Row="4" Grid.Column="1" Content="."  Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="." />
            <Button Grid.Row="4" Grid.Column="2" Content="sin" Style="{StaticResource AxialKeyButtonStyle}" Click="OnKey" Tag="sin(" />
            <Button Grid.Row="4" Grid.Column="3" Content="+"  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="+" />
            <Button Grid.Row="4" Grid.Column="4" Content="="  Style="{StaticResource AxialKeyAccentStyle}" Click="OnKey" Tag="=" />
        </Grid>
    </Grid>
</Page>
