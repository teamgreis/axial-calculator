<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Axial-Design-Tokens: Akzent, Radien, Abstände, Schriften -->
    <Color x:Key="AxialAccentColor">#7C5CFF</Color>
    <Color x:Key="AxialAccentSecondaryColor">#00C2A8</Color>
    <Color x:Key="AxialSurfaceColor">#14161A</Color>
    <Color x:Key="AxialOnSurfaceColor">#F2F3F5</Color>
    <Color x:Key="AxialOnSurfaceVariantColor">#A6ADB8</Color>

    <SolidColorBrush x:Key="AxialAccentBrush" Color="{StaticResource AxialAccentColor}" />
    <SolidColorBrush x:Key="AxialAccentSecondaryBrush" Color="{StaticResource AxialAccentSecondaryColor}" />
    <SolidColorBrush x:Key="AxialOnSurfaceBrush" Color="{StaticResource AxialOnSurfaceColor}" />
    <SolidColorBrush x:Key="AxialOnSurfaceVariantBrush" Color="{StaticResource AxialOnSurfaceVariantColor}" />

    <!-- Radien (Liquid-Glass-Skala) -->
    <CornerRadius x:Key="AxialCornerRadiusTight">6</CornerRadius>
    <CornerRadius x:Key="AxialCornerRadiusDefault">12</CornerRadius>
    <CornerRadius x:Key="AxialCornerRadiusPill">999</CornerRadius>

    <!-- Abstände -->
    <Thickness x:Key="AxialPaddingTight">8</Thickness>
    <Thickness x:Key="AxialPaddingDefault">16</Thickness>

    <!-- Akzent-Button-Stil (Tastenfeld) -->
    <Style x:Key="AxialKeyButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="CornerRadius" Value="{StaticResource AxialCornerRadiusTight}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AxialOnSurfaceBrush}" />
    </Style>

    <!-- Akzent-Taste (Rechenzeichen) -->
    <Style x:Key="AxialKeyAccentStyle" TargetType="Button" BasedOn="{StaticResource AxialKeyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AxialAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</ResourceDictionary>
